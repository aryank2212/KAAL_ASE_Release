# KAAL ASE settings. One KEY=VALUE per line. Real environment variables win over this file.
# Restart the service after editing:  sudo systemctl restart kaal-ase

# Where the API listens. Keep 127.0.0.1 unless you put it behind a VPN (e.g. your Tailscale address) or a reverse proxy.
#KAAL_HOST=127.0.0.1
#KAAL_PORT=8140

# The model host (for example your laptop). You can also set this live in the console: Models tab.
#OLLAMA_BASE_URL=http://100.64.0.2:11434

# Optional data sources
#AISSTREAM_API_KEY=         # free key from aisstream.io, enables the Ships layer
#OPENSKY_CLIENT_ID=         # optional, raises OpenSky rate limits
#OPENSKY_CLIENT_SECRET=

# Optional tools (paths). ExifTool is detected automatically when installed.
#EXIFTOOL_BIN=/usr/bin/exiftool
#HOLEHE_BIN=
#GHUNT_BIN=
