# Maintainer: RedClove <mail.redclove@gmail.com>
# Built from a source tarball of this repository. The release workflow creates it with `git archive` and runs
# `updpkgsums`, so the checksum below is filled in at build time.
pkgname=kaal-ase
pkgver=2.2.0
pkgrel=1
pkgdesc="KAAL ASE: guardrailed public-source OSINT API and web console"
arch=('any')
url="https://github.com/aryank2212/KAAL_ASE_Release"
license=('custom')   # the repository does not ship a LICENSE file yet
depends=('python' 'perl-image-exiftool' 'ca-certificates')
optdepends=('ollama: local model host' 'systemd: always-on service')
backup=('etc/kaal-ase/kaal-ase.env')
install=kaal-ase.install
source=("$pkgname-$pkgver.tar.gz" 'kaal-ase.sysusers' 'kaal-ase.tmpfiles')
sha256sums=('SKIP' 'SKIP' 'SKIP')

package() {
  cd "$srcdir/$pkgname-$pkgver"
  install -d "$pkgdir/opt/kaal-ase"
  cp -r services/api/app "$pkgdir/opt/kaal-ase/app"
  find "$pkgdir/opt/kaal-ase/app" -name '__pycache__' -type d -prune -exec rm -rf {} +
  find "$pkgdir/opt/kaal-ase" -type d -exec chmod 755 {} +
  find "$pkgdir/opt/kaal-ase/app" -type f -exec chmod 644 {} +
  install -Dm644 services/api/requirements-core.txt "$pkgdir/opt/kaal-ase/requirements-core.txt"
  sed 's#^T="${KAAL_TOOLS_DIR:-$HOME/.kaal/tools}"#T="${KAAL_TOOLS_DIR:-/var/lib/kaal-ase/tools}"#' scripts/install_optional_tools.sh \
    | install -Dm755 /dev/stdin "$pkgdir/opt/kaal-ase/install-optional-tools.sh"
  install -Dm755 packaging/common/kaal-ase.sh "$pkgdir/usr/bin/kaal-ase"
  install -Dm755 scripts/kaal-model.py "$pkgdir/usr/bin/kaal-model"
  install -Dm644 packaging/common/kaal-ase.service "$pkgdir/usr/lib/systemd/system/kaal-ase.service"
  install -Dm644 packaging/common/kaal-ase.env "$pkgdir/etc/kaal-ase/kaal-ase.env"
  install -Dm644 "$srcdir/kaal-ase.sysusers" "$pkgdir/usr/lib/sysusers.d/kaal-ase.conf"
  install -Dm644 "$srcdir/kaal-ase.tmpfiles" "$pkgdir/usr/lib/tmpfiles.d/kaal-ase.conf"
  install -Dm644 CHANGELOG.md "$pkgdir/usr/share/doc/kaal-ase/CHANGELOG.md"
  install -Dm644 docs/osint-connectors.md "$pkgdir/usr/share/doc/kaal-ase/osint-connectors.md"
}
